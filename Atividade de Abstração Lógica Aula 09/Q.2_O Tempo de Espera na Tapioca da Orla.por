programa {
  funcao inicio() {
    real  quantidade, minutos, resultado

     escreva("Quantas tapiocas serão feitas? ")
     leia(quantidade)

      escreva("Quantos minutos levará para a tapioca ficar pronta? ")
      leia(minutos)

    resultado = quantidade * minutos

   
    escreva("Sandra irá esperar por ",resultado, "minutos")

  }
}
