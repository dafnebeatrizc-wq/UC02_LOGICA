programa {
  funcao inicio() {


      // Declaração de variáveis 

    real medidaBase
    real medidaAltura
    real areaTriangulo



     // Entrada de dados 

    escreva("Base: ")
    leia(medidaBase)

    escreva("Altura: ")
    leia(medidaAltura)



       // Processamento 

areaTriangulo = (medidaBase * medidaAltura) / 2


       // Saída 
      escreva("Area do triangulo: ", areaTriangulo)



  }
}
