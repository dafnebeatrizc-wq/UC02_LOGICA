programa {
    
     real peso
     cadeia idade

        funcao inicio (){

        escreve( "O peso (em KG) do provável doador: ")
        leia (peso)

    
    escreva ("Idade do provável doador: ")
    leia(idade)

     se ( peso >= 50 e idade >= 16 <= 69){

            escreva ("Ele é um doador compátivel.Prabéns! ")
            
        }

        senao escreva (" Doador incompátivel. ")
    }
}
